# LLM Provider
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o

# Embedding Model (Qwen3-Embedding-4B via OpenAI-compatible API)
EMBEDDING_API_BASE=https://api.deepseek.com
EMBEDDING_API_KEY=sk-your-embedding-api-key
EMBEDDING_MODEL_NAME=Qwen3-Embedding-4B
EMBEDDING_DIM=1024

# Redis (短期记忆)
REDIS_URL=redis://localhost:6379/0

# Vector Store (长期记忆)
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=./vector_store/faiss_index
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# OpenTelemetry (全链路追踪)
OTEL_SERVICE_NAME=smart-cs-multi-agent
# Leave blank for local development without Jaeger/OTLP collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=always_on

# LangSmith (可选)
# LANGSMITH_API_KEY=ls-your-langsmith-key
# LANGSMITH_PROJECT=smart-cs-agent

# Server
HOST=0.0.0.0
PORT=8000
