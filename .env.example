# LLM Provider
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o

# Embedding Model — 本地 Qwen3-Embedding-0.6B
# 启动本地服务: python embedding_server.py
# 默认监听 http://localhost:6008
EMBEDDING_API_BASE=http://localhost:6008
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024

# Redis (短期记忆)
REDIS_URL=redis://localhost:6379/0

# Vector Store (长期记忆)
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=./vector_store/faiss_index
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# OpenTelemetry (全链路追踪)
OTEL_SERVICE_NAME=smart-cs-multi-agent
# Leave blank for local development without Jaeger/OTLP collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=always_on

# LangSmith (可选)
# LANGSMITH_API_KEY=ls-your-langsmith-key
# LANGSMITH_PROJECT=smart-cs-agent

# Server
HOST=0.0.0.0
PORT=8000

# Harness: CORS (comma-separated origins, default localhost)
CORS_ORIGINS=http://localhost:8000

# Harness: API Keys (comma-separated, empty = no auth in dev mode)
API_KEYS=
