# LLM Provider (OpenAI 兼容)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
MODEL_TEMPERATURE=0

# Embedding Model — 本地 Qwen3-Embedding-0.6B
# 启动本地服务: python embedding_server.py
# 默认监听 http://localhost:6008
EMBEDDING_API_BASE=http://localhost:6008
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
EMBEDDING_COOLDOWN_SECONDS=60

# Redis (短期记忆)
REDIS_URL=redis://localhost:6379/0

# Vector Store (长期记忆)
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=./vector_store/faiss_index

# Memory tuning
SHORT_TERM_MAX_TURNS=20
SHORT_TERM_TTL_SECONDS=1800
WORKING_MEMORY_MAX_ENTRIES=50
CLEANUP_INTERVAL_SECONDS=300
CLEANUP_MAX_AGE_SECONDS=1800

# OpenTelemetry (全链路追踪)
OTEL_SERVICE_NAME=fin-customer-agent
# Leave blank for local development without Jaeger/OTLP collector.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Server
HOST=0.0.0.0
PORT=8000
# Set to "true" to enable uvicorn --reload when running locally via `python -m app.main`.
APP_RELOAD=false

# Harness: CORS (comma-separated origins, default localhost)
CORS_ORIGINS=http://localhost:8000

# Harness: API Keys (comma-separated, empty = no auth in dev mode)
API_KEYS=

# Harness: Tool sandbox timeout (seconds)
SANDBOX_TIMEOUT_SECONDS=30